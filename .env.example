# -----------------------------
# Required for backend optimizer API (/api/optimize)
# -----------------------------
PORT=8787
OPTIMIZER_PROVIDER=openrouter
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=5m

# Optional cloud fallback (used if Ollama fails and key is set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_SITE_NAME=Project Dunamis

# -----------------------------
# Frontend Firebase config (VITE_ vars are public client config)
# -----------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional frontend config
VITE_API_BASE=http://localhost:8787
VITE_TURNSTILE_SITE_KEY=
VITE_BASE=./

# -----------------------------
# Optional backend features
# -----------------------------
# Usage limits
DAILY_LIMIT=5

# Supabase (optional; if missing, server falls back to in-memory usage tracking)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth/contact hardening (optional)
ALLOWLIST_EMAILS=
CORS_ORIGIN=*
TURNSTILE_SECRET_KEY=
CONTACT_MIN_INTERVAL_MS=60000

# Contact delivery (optional)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_WEBHOOK_URL=

# Ko-fi webhook (optional)
KOFI_WEBHOOK_TOKEN=

# IndexNow (optional)
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_SITE_URL=
INDEXNOW_KEY_LOCATION=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
