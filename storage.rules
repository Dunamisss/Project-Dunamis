rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // Avatar uploads - only the owning user
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImageUpload(2 * 1024 * 1024);
    }

    // Prompt submission attachments - authenticated users can upload
    match /prompt-submissions/{submissionId}/attachment/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource != null && request.resource.size <= 10 * 1024 * 1024;
    }

    // Community image submissions - authenticated users can upload
    match /submissions/images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImageUpload(10 * 1024 * 1024);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
